# Copy this file to .env and fill in your credentials

# Angular admin app (qa-us-admin.vct2.work)
TEST_USERNAME=your-email@example.com
TEST_PASSWORD=your-password

# Legacy ASP.NET admin app (dev-web-us.vctrials.com)
# Falls back to TEST_USERNAME / TEST_PASSWORD if not set
LEGACY_BASE_URL=https://dev-web-us.vctrials.com
LEGACY_ADMIN_USERNAME=your-admin@example.com
LEGACY_ADMIN_PASSWORD=your-admin-password

# Global API token (api-v2.vct2.work)
GLOBAL_API_TOKEN=your-global-api-token

# Read-only Subjects smoke test; uses TEST_USERNAME / TEST_PASSWORD
SUBJECTS_BASE_URL=https://qa-web-us.vctrials.com

# Read-only Protocols and Site Contacts smoke tests; uses TEST_USERNAME / TEST_PASSWORD
LEGACY_SEARCH_BASE_URL=https://qa-web-us.vctrials.com
